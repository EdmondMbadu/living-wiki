{
  "name": "living-atlast",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm run start:localized",
    "start:localized": "npm run build:hosting && node scripts/serve-localized.mjs",
    "start:dev": "ng serve",
    "start:fr": "ng serve --configuration fr",
    "start:ja": "ng serve --configuration ja",
    "build": "ng build",
    "i18n:mark": "node scripts/mark-angular-i18n.mjs && node scripts/mark-typescript-i18n.mjs && node scripts/mark-chat-ui-i18n.mjs",
    "i18n:extract": "node scripts/extract-angular-i18n.mjs",
    "i18n:check": "node scripts/check-angular-catalogs.mjs",
    "build:ios:web": "ng build --configuration production",
    "ios:sync": "npx cap sync ios",
    "build:hosting": "npm run i18n:check && ng build --configuration production && node scripts/prepare-hosting-runtime-config.mjs && node scripts/check-board-performance.mjs",
    "deploy:hosting": "npm run build:hosting && firebase deploy --only hosting",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:firestore-rules": "node scripts/run-firestore-rule-tests.mjs",
    "test:storage-rules": "node scripts/run-storage-rule-tests.mjs",
    "university-boards:worker": "npm --prefix functions run build && node scripts/run-university-board-worker.mjs",
    "university-boards:set-worker": "npm --prefix functions run build && node scripts/run-university-board-set-worker.mjs",
    "university-boards:free-worker": "npm --prefix functions run build && node scripts/run-university-board-set-worker.mjs",
    "university-boards:images": "node scripts/enrich-university-board-images.mjs",
    "universities:heroes": "node scripts/enrich-university-hero-catalog.mjs",
    "universities:heroes:sync": "node scripts/sync-university-hero-catalog.mjs",
    "university-boards:publish": "node scripts/publish-university-boards.mjs",
    "university-boards:catalog": "node scripts/reconcile-university-board-catalog.mjs",
    "university-boards:promote-recovered": "node scripts/promote-recovered-university-boards.mjs",
    "university-boards:audit-job": "node scripts/audit-university-board-job.mjs",
    "university-boards:validate-artifact": "node scripts/validate-university-board-artifact.mjs",
    "university-boards:resume-free": "node scripts/resume-free-university-board-catalog.mjs",
    "serve:ssr:living-atlast": "node dist/living-atlast/server/server.mjs"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@alexanderolsen/libsamplerate-js": "2.1.2",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.3",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@elevenlabs/client": "^1.21.0",
    "d3-geo": "^3.1.1",
    "d3-geo-polygon": "^2.0.1",
    "express": "^5.1.0",
    "firebase": "^12.12.0",
    "heic2any": "^0.0.4",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "topojson-client": "^3.1.0",
    "tslib": "^2.3.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@angular/build": "^20.3.3",
    "@angular/cli": "^20.3.3",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/localize": "^20.3.18",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/d3-geo": "^3.1.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "~5.1.0",
    "@types/node": "^20.17.19",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.2"
  }
}
