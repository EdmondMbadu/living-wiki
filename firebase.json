{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "runtime": "nodejs22"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist/living-atlast/browser",
    "predeploy": [
      "npm run build:hosting"
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/media/off-grid",
        "function": {
          "functionId": "offGridMedia",
          "region": "us-central1"
        }
      },
      {
        "source": "/share/off-grid/**",
        "function": {
          "functionId": "offGridShare",
          "region": "us-central1"
        }
      },
      {
        "source": "/share/answer-card/**",
        "function": {
          "functionId": "answerCardShare",
          "region": "us-central1"
        }
      },
      {
        "source": "/share/travel-card/**",
        "function": {
          "functionId": "travelCardShare",
          "region": "us-central1"
        }
      },
      {
        "source": "/share/board/**",
        "function": {
          "functionId": "boardShare",
          "region": "us-central1"
        }
      },
      {
        "source": "/go/**",
        "function": {
          "functionId": "visitPlanGuest",
          "region": "us-central1"
        }
      },
      {
        "source": "/auth/spotify/callback",
        "function": {
          "functionId": "spotifyOAuthCallback",
          "region": "us-central1"
        }
      },
      {
        "source": "/fr",
        "destination": "/fr/index.html"
      },
      {
        "source": "/fr/**",
        "destination": "/fr/index.csr.html"
      },
      {
        "source": "/ja",
        "destination": "/ja/index.html"
      },
      {
        "source": "/ja/**",
        "destination": "/ja/index.csr.html"
      },
      {
        "source": "/pt",
        "destination": "/pt/index.html"
      },
      {
        "source": "/pt/**",
        "destination": "/pt/index.csr.html"
      },
      {
        "source": "/es",
        "destination": "/es/index.html"
      },
      {
        "source": "/es/**",
        "destination": "/es/index.csr.html"
      },
      {
        "source": "/de",
        "destination": "/de/index.html"
      },
      {
        "source": "/de/**",
        "destination": "/de/index.csr.html"
      },
      {
        "source": "/zh",
        "destination": "/zh/index.html"
      },
      {
        "source": "/zh/**",
        "destination": "/zh/index.csr.html"
      },
      {
        "source": "/it",
        "destination": "/it/index.html"
      },
      {
        "source": "/it/**",
        "destination": "/it/index.csr.html"
      },
      {
        "source": "/ko",
        "destination": "/ko/index.html"
      },
      {
        "source": "/ko/**",
        "destination": "/ko/index.csr.html"
      },
      {
        "source": "/ar",
        "destination": "/ar/index.html"
      },
      {
        "source": "/ar/**",
        "destination": "/ar/index.csr.html"
      },
      {
        "source": "/hi",
        "destination": "/hi/index.html"
      },
      {
        "source": "/hi/**",
        "destination": "/hi/index.csr.html"
      },
      {
        "source": "/ru",
        "destination": "/ru/index.html"
      },
      {
        "source": "/ru/**",
        "destination": "/ru/index.csr.html"
      },
      {
        "source": "**",
        "destination": "/index.csr.html"
      }
    ],
    "headers": [
      {
        "source": "/{,fr/,ja/,pt/,es/,de/,zh/,it/,ko/,ar/,hi/,ru/}reports{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-store"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/{,fr/,ja/,pt/,es/,de/,zh/,it/,ko/,ar/,hi/,ru/}notifications{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/fr/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/ja/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/pt/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/es/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/{,fr/,ja/,pt/,es/,de/,zh/,it/,ko/,ar/,hi/,ru/}boards{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "**/!(runtime-config).@(js|css|png|jpg|jpeg|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/{,fr/,ja/,pt/,es/,de/,zh/,it/,ko/,ar/,hi/,ru/}runtime-config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/de/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/zh/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/it/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/ko/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/ar/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/hi/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      },
      {
        "source": "/ru/teams{,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache,max-age=0,must-revalidate"
          }
        ]
      }
    ]
  }
}
