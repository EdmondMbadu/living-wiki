          'learningQuiz',
          'parentBoardId',
          'parentCardId',
          'parentBoardTitle',
          'parentCardTitle',
          'insideCardsDisplay',
          'showCardNumbers',
          'like_count',
          'atlas_id',
          'generated_for_atlas_id',
          'origin',
          'publisher_type',
          'generation_job_id',
          'generation_item_id',
          'generation_key',
          'generator_version',
          'template_id',
          'template_version',
          'rubric_version',
          'editorial_status',
          'city_listing_status',
          'city_feature_order',
          'source_status',
          'quality_status',
