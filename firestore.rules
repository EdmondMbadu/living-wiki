        )
        && (
          !request.resource.data.keys().hasAny(['additional_qr_url'])
          || (
            request.resource.data.additional_qr_url is string
            && request.resource.data.additional_qr_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['ai_tone'])
          || request.resource.data.ai_tone in ['warm', 'calm', 'upbeat', 'professional', 'concise', 'premium']
        )
        && (
          !request.resource.data.keys().hasAny(['business_documents_enabled'])
          || request.resource.data.business_documents_enabled is bool
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status in ['idle', 'checkout_started', 'paid', 'cancelled']
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid is bool
        )
        && (
          !request.resource.data.keys().hasAny(['logo_url'])
          || (
            request.resource.data.logo_url is string
            && request.resource.data.logo_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['profile_image_url'])
          || (
            request.resource.data.profile_image_url is string
            && request.resource.data.profile_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['cover_image_url'])
          || (
            request.resource.data.cover_image_url is string
            && request.resource.data.cover_image_url.size() <= 1200
          )
        )
        && (
          !request.resource.data.keys().hasAny(['status'])
          || request.resource.data.status in ['pending', 'verified', 'rejected']
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
          || (
            !resource.data.keys().hasAny(['status'])
            && request.resource.data.status == 'pending'
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['created_at'])
          || request.resource.data.created_at == request.time
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['updated_at'])
          || request.resource.data.updated_at == request.time
        )
      ) || (
        isPlatformAdmin()
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updated_at'
        ])
        && request.resource.data.status in ['pending', 'verified', 'rejected']
        && request.resource.data.updated_at == request.time
      );
      allow delete: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
    }

    // Analytics are written and read only through validated Cloud Functions.
    // Keeping these collections opaque prevents authors from inflating counters
    // or discovering another board's traffic details with direct SDK calls.
    match /board_analytics_daily_shards/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_event_receipts/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_unique_receipts/{documentId} {
      allow read, write: if false;
    }

    match /board_analytics_rate_limits/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
