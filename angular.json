{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "living-atlast": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": ""
        },
        "locales": {
          "fr": {
            "translation": "src/locale/messages.fr.json",
            "subPath": "fr"
          },
          "ja": {
            "translation": "src/locale/messages.ja.json",
            "subPath": "ja"
          },
          "pt-BR": {
            "translation": "src/locale/messages.pt-BR.json",
            "subPath": "pt"
          },
          "es-419": {
            "translation": "src/locale/messages.es-419.json",
            "subPath": "es"
          },
          "de": {
            "translation": "src/locale/messages.de.json",
            "subPath": "de"
          },
          "zh-Hans": {
            "translation": "src/locale/messages.zh-Hans.json",
            "subPath": "zh"
          },
          "it": {
            "translation": "src/locale/messages.it.json",
            "subPath": "it"
          },
          "ko": {
            "translation": "src/locale/messages.ko.json",
            "subPath": "ko"
          },
          "ar": {
            "translation": "src/locale/messages.ar.json",
            "subPath": "ar"
          },
          "hi": {
            "translation": "src/locale/messages.hi.json",
            "subPath": "hi"
          },
          "ru": {
            "translation": "src/locale/messages.ru.json",
            "subPath": "ru"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "@angular/localize/init"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "libsamplerate.worklet.js",
                "input": "node_modules/@alexanderolsen/libsamplerate-js/dist",
                "output": "/voice/libsamplerate-2.1.2"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "localize": true,
              "i18nMissingTranslation": "error",
              "i18nDuplicateTranslation": "error",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.65MB",
                  "maximumError": "2.865MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "165kB",
                  "maximumError": "175kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "localize": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fr": {
              "localize": [
                "fr"
              ]
            },
            "ja": {
              "localize": [
                "ja"
              ]
            },
            "pt": {
              "localize": [
                "pt-BR"
              ]
            },
            "es": {
              "localize": [
                "es-419"
              ]
            },
            "de": {
              "localize": [
                "de"
              ]
            },
            "zh": {
              "localize": [
                "zh-Hans"
              ]
            },
            "it": {
              "localize": [
                "it"
              ]
            },
            "ko": {
              "localize": [
                "ko"
              ]
            },
            "ar": {
              "localize": [
                "ar"
              ]
            },
            "hi": {
              "localize": [
                "hi"
              ]
            },
            "ru": {
              "localize": [
                "ru"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "living-atlast:build:production"
            },
            "development": {
              "buildTarget": "living-atlast:build:development"
            },
            "fr": {
              "buildTarget": "living-atlast:build:development,fr"
            },
            "ja": {
              "buildTarget": "living-atlast:build:development,ja"
            },
            "pt": {
              "buildTarget": "living-atlast:build:development,pt"
            },
            "es": {
              "buildTarget": "living-atlast:build:development,es"
            },
            "de": {
              "buildTarget": "living-atlast:build:development,de"
            },
            "zh": {
              "buildTarget": "living-atlast:build:development,zh"
            },
            "it": {
              "buildTarget": "living-atlast:build:development,it"
            },
            "ko": {
              "buildTarget": "living-atlast:build:development,ko"
            },
            "ar": {
              "buildTarget": "living-atlast:build:development,ar"
            },
            "hi": {
              "buildTarget": "living-atlast:build:development,hi"
            },
            "ru": {
              "buildTarget": "living-atlast:build:development,ru"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "@angular/localize/init"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "libsamplerate.worklet.js",
                "input": "node_modules/@alexanderolsen/libsamplerate-js/dist",
                "output": "/voice/libsamplerate-2.1.2"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          },
          "configurations": {
            "language-support": {
              "tsConfig": "tsconfig.languages.spec.json",
              "include": [
                "src/app/i18n/locales.spec.ts",
                "src/app/boards/board-translation.spec.ts",
                "src/app/boards/board-language-playback.spec.ts",
                "src/app/boards/narration-voice.spec.ts",
                "src/app/boards/tour-handoff.spec.ts",
                "src/app/boards/card-share.spec.ts",
                "src/app/boards/card-live-route.spec.ts",
                "src/app/boards/talking-card.spec.ts",
                "src/app/talking-card-conversation/talking-card-conversation.spec.ts",
                "src/app/boards/live-language.spec.ts",
                "src/app/boards/live-language-dialog.spec.ts",
                "src/app/boards/board-studio-persistence.spec.ts",
                "src/app/language-switcher/language-switcher.spec.ts"
              ]
            },
            "analytics-support": {
              "tsConfig": "tsconfig.analytics.spec.json",
              "include": [
                "src/app/board-insights/board-insights.spec.ts",
                "src/app/card-analytics/card-analytics.spec.ts",
                "src/app/platform-analytics/platform-analytics.spec.ts",
                "src/app/platform-analytics/picamo-analytics.spec.ts",
                "src/app/board-analytics.service.spec.ts",
                "src/app/analytics-report-sharing/analytics-report-sharing.spec.ts",
                "src/app/shared-analytics/shared-analytics.spec.ts",
                "src/app/app.spec.ts"
              ]
            }
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
