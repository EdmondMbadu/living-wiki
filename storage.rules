rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function teamMember(teamId) {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.status == 'active'
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.status == 'active';
    }
    match /team-branding/{teamId}/{fileName} {
      allow read: if true;
      allow create: if resource == null && teamMember(teamId)
        && firestore.get(/databases/(default)/documents/teams/$(teamId)/members/$(request.auth.uid)).data.role == 'admin'
        && request.resource.contentType.matches('image/(jpeg|png|webp)')
        && request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024;
      allow update, delete: if false;
    }
    match /team-media/{teamId}/{fileName=**} {
      allow read: if teamMember(teamId);
      allow create: if resource == null && teamMember(teamId)
        && ((request.resource.contentType.matches('image/(jpeg|png|webp)') && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size <= 100 * 1024 * 1024))
        && request.resource.size > 0;
      allow update, delete: if false;
    }
    match /public-team-media/{teamId}/{boardId}/{fileName} {
      allow read: if firestore.get(/databases/(default)/documents/boards/$(boardId)).data.visibility == 'public'
        && firestore.get(/databases/(default)/documents/boards/$(boardId)).data.team_id == teamId;
      allow write: if false;
    }
    function canManageAtlas(atlasId) {
      let atlas = firestore.get(/databases/(default)/documents/atlases/$(atlasId)).data;
      return request.auth != null
        && (
          atlas.user_id == request.auth.uid
          || (atlas.admin_user_ids is list && request.auth.uid in atlas.admin_user_ids)
        );
    }

    match /public-board-covers/{boardId}/{fileName=**} {
      allow read: if true;
      allow write: if false;
    }

    match /app-assets/stack-audio/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId}/documents/{documentId}/{fileName=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/profile/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{userId}/voice-samples/{fileName=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size > 0
        && request.resource.size <= 60 * 1024 * 1024;
    }

    match /users/{userId}/board-doc-exports/{fileName=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{userId}/avatars/{atlasId}/{fileName=**} {
      allow read: if true;
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size > 0
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /users/{userId}/video-library/{fileName=**} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('video/.*')
        && request.resource.size > 0
        && request.resource.size < 100 * 1024 * 1024;
    }

    match /users/{userId}/boards/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        );
    }

    match /atlases/{atlasId}/{fileName=**} {
      allow read: if true;
      allow delete: if canManageAtlas(atlasId);
      allow create, update: if canManageAtlas(atlasId)
        && (
          (request.resource.contentType.matches('image/.*') && request.resource.size < 10 * 1024 * 1024)
          || (request.resource.contentType.matches('video/.*') && request.resource.size < 100 * 1024 * 1024)
        );
    }

    match /businesses/{userId}/{claimKey}/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
