{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "living-atlast": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "i18n": {
        "sourceLocale": {
          "code": "en-US",
          "subPath": ""
        },
        "locales": {
          "fr": {
            "translation": "src/locale/messages.fr.json",
            "subPath": "fr"
          },
          "ja": {
            "translation": "src/locale/messages.ja.json",
            "subPath": "ja"
          },
          "pt-BR": {
            "translation": "src/locale/messages.pt-BR.json",
            "subPath": "pt"
          }
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "polyfills": [
              "@angular/localize/init"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "libsamplerate.worklet.js",
                "input": "node_modules/@alexanderolsen/libsamplerate-js/dist",
                "output": "/voice/libsamplerate-2.1.2"
              }
            ],
            "styles": [
              "src/styles.css"
            ],
            "server": "src/main.server.ts",
            "outputMode": "server",
            "ssr": {
              "entry": "src/server.ts"
            }
          },
          "configurations": {
            "production": {
              "localize": true,
              "i18nMissingTranslation": "error",
              "i18nDuplicateTranslation": "error",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "2.65MB",
                  "maximumError": "2.865MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "165kB",
                  "maximumError": "175kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "localize": false,
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "fr": {
              "localize": [
                "fr"
              ]
            },
            "ja": {
              "localize": [
                "ja"
              ]
            },
            "pt": {
              "localize": [
                "pt-BR"
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "living-atlast:build:production"
            },
            "development": {
              "buildTarget": "living-atlast:build:development"
            },
            "fr": {
              "buildTarget": "living-atlast:build:development,fr"
            },
            "ja": {
              "buildTarget": "living-atlast:build:development,ja"
            },
            "pt": {
              "buildTarget": "living-atlast:build:development,pt"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n"
        },
        "test": {
          "builder": "@angular/build:karma",
          "options": {
            "tsConfig": "tsconfig.spec.json",
            "polyfills": [
              "@angular/localize/init"
            ],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "libsamplerate.worklet.js",
                "input": "node_modules/@alexanderolsen/libsamplerate-js/dist",
                "output": "/voice/libsamplerate-2.1.2"
              }
            ],
            "styles": [
              "src/styles.css"
            ]
          }
        }
      }
    }
  },
  "cli": {
    "analytics": false,
    "cache": {
      "enabled": false
    }
  }
}
