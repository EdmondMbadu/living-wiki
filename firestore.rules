rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isPlatformAdmin() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasActivePersonalWikiPlan() {
      return isSignedIn()
        && (
          userProfile().pricingPlan in ['personal_plus', 'creator', 'explorer', 'lifetime']
          || userProfile().pricing_plan in ['personal_plus', 'creator', 'explorer', 'lifetime']
        )
        && (
          userProfile().subscriptionStatus in ['active', 'trialing', 'paid']
          || userProfile().subscription_status in ['active', 'trialing', 'paid']
        );
    }

    function canCreateWiki() {
      return isPlatformAdmin() || hasActivePersonalWikiPlan();
    }

    function isValidStackNarratorVoiceId(value) {
      return value in [
        'warm-storyteller',
        'inspiring-guide',
        'confident-narrator',
        'energetic-host',
        'calm-documentary',
        'vibrant-presenter',
        'teenage-girl',
        'elegant-guide',
        'british-storyteller',
        'cinematic-narrator',
        'friendly-explainer',
        'personal-voice'
      ] || (
        value is string
        && value.matches('personal-voice:[A-Za-z0-9_-]{1,64}')
      );
    }

    function isValidBoardNarrationStyle(value) {
      return value in [
        'storyteller',
        'personal-story',
        'teen-perspective',
        'guided-tour',
        'documentary'
      ];
    }

    function hasValidBoardNarrationLength(data) {
      return !data.keys().hasAny(['narrationSecondsPerCard'])
        || (
          data.narrationSecondsPerCard is number
          && data.narrationSecondsPerCard >= 5
          && data.narrationSecondsPerCard <= 180
        );
    }

    function hasValidSocialVideoClosingScreen(data) {
      return (
          !data.keys().hasAny(['socialVideoClosingHeadline'])
          || (
            data.socialVideoClosingHeadline is string
            && data.socialVideoClosingHeadline.size() <= 72
          )
        )
        && (
          !data.keys().hasAny(['socialVideoClosingMessage'])
          || (
            data.socialVideoClosingMessage is string
            && data.socialVideoClosingMessage.size() <= 180
          )
        )
        && (
          !data.keys().hasAny(['socialVideoClosingShowQrCode'])
          || data.socialVideoClosingShowQrCode is bool
        )
        && (
          !data.keys().hasAny(['socialVideoClosingImage'])
          || data.socialVideoClosingImage in ['cover', 'final-card', 'custom']
        )
        && (
          !data.keys().hasAny(['socialVideoClosingCustomImageUrl'])
          || (
            data.socialVideoClosingCustomImageUrl is string
            && data.socialVideoClosingCustomImageUrl.size() <= 2000
          )
        )
        && (
          !data.keys().hasAny(['socialVideoClosingImage'])
          || data.socialVideoClosingImage != 'custom'
          || (
            data.keys().hasAny(['socialVideoClosingCustomImageUrl'])
            && data.socialVideoClosingCustomImageUrl is string
            && data.socialVideoClosingCustomImageUrl.size() > 0
          )
        )
        && (
          !data.keys().hasAny(['socialVideoClosingDurationSeconds'])
          || (
            data.socialVideoClosingDurationSeconds is number
            && data.socialVideoClosingDurationSeconds >= 2
            && data.socialVideoClosingDurationSeconds <= 6
          )
        );
    }

    function hasValidLandscapeVideoFields(data) {
      return (
          !data.keys().hasAny(['socialLandscapeVideoUrl'])
          || (data.socialLandscapeVideoUrl is string && data.socialLandscapeVideoUrl.size() <= 2500)
        )
        && (
          !data.keys().hasAny(['socialLandscapeVideoMimeType'])
          || (data.socialLandscapeVideoMimeType is string && data.socialLandscapeVideoMimeType.size() <= 120)
        )
        && (
          !data.keys().hasAny(['socialLandscapeVideoUpdatedAt'])
          || (data.socialLandscapeVideoUpdatedAt is string && data.socialLandscapeVideoUpdatedAt.size() <= 80)
        )
        && (
          !data.keys().hasAny(['socialLandscapeVideoRenderVersion'])
          || (data.socialLandscapeVideoRenderVersion is string && data.socialLandscapeVideoRenderVersion.size() <= 64)
        )
        && (
          !data.keys().hasAny(['socialLandscapeVideoDurationSeconds'])
          || (data.socialLandscapeVideoDurationSeconds is number && data.socialLandscapeVideoDurationSeconds >= 0)
        )
        && (
          !data.keys().hasAny(['trailerLandscapeVideoUrl'])
          || (data.trailerLandscapeVideoUrl is string && data.trailerLandscapeVideoUrl.size() <= 2500)
        )
        && (
          !data.keys().hasAny(['trailerLandscapeVideoMimeType'])
          || (data.trailerLandscapeVideoMimeType is string && data.trailerLandscapeVideoMimeType.size() <= 120)
        )
        && (
          !data.keys().hasAny(['trailerLandscapeVideoUpdatedAt'])
          || (data.trailerLandscapeVideoUpdatedAt is string && data.trailerLandscapeVideoUpdatedAt.size() <= 80)
        )
        && (
          !data.keys().hasAny(['trailerLandscapeVideoRenderVersion'])
          || (data.trailerLandscapeVideoRenderVersion is string && data.trailerLandscapeVideoRenderVersion.size() <= 64)
        )
        && (
          !data.keys().hasAny(['trailerLandscapeVideoDurationSeconds'])
          || (data.trailerLandscapeVideoDurationSeconds is number && data.trailerLandscapeVideoDurationSeconds >= 0)
        );
    }

    function hasValidLibraryLandscapeVariant(data) {
      let fields = [
        'landscape_video_url',
        'landscape_storage_path',
        'landscape_public_storage_path',
        'landscape_mime_type',
        'landscape_duration_seconds',
        'landscape_render_version',
        'landscape_generated_at_iso'
      ];
      return !data.keys().hasAny(fields)
        || (
          data.keys().hasAll(fields)
          && data.landscape_video_url is string
          && data.landscape_video_url.size() <= 2500
          && data.landscape_storage_path is string
          && data.landscape_storage_path.size() <= 500
          && data.landscape_public_storage_path is string
          && data.landscape_public_storage_path.size() <= 500
          && data.landscape_mime_type is string
          && data.landscape_mime_type.size() <= 120
          && (data.landscape_video_url == '' || data.landscape_mime_type.matches('video/.*'))
          && data.landscape_duration_seconds is number
          && data.landscape_duration_seconds >= 0
          && data.landscape_render_version is string
          && data.landscape_render_version.size() <= 64
          && data.landscape_generated_at_iso is string
          && data.landscape_generated_at_iso.size() <= 80
        );
    }

    function personalBoardKeys() {
      return [
        'id',
        'owner_user_id',
        'owner_public_slug',
        'owner_display_name',
        'owner_photo_url',
        'owner_profile_icon',
        'owner_profile_picture_type',
        'custom_slug',
        'forkedFromBoardId',
        'forkedFromTitle',
        'forkedFromOwnerUserId',
        'forkedFromOwnerName',
        'visibility',
        'photoStoryBoard',
        'photoStudioDraft',
        'kind',
        'sortOrder',
        'title',
        'description',
        'backNote',
        'icon',
        'tone',
        'imageUrl',
        'logoUrl',
        'logoLinkUrl',
        'stackCtaLabel',
        'stackCtaUrl',
        'socialVideoUrl',
        'socialVideoMimeType',
        'socialVideoUpdatedAt',
        'socialVideoRenderVersion',
        'socialVideoRatio',
        'socialVideoAudioTrackId',
        'socialVideoAudioVolume',
        'socialVideoNarrationEnabled',
        'socialLandscapeVideoUrl',
        'socialLandscapeVideoMimeType',
        'socialLandscapeVideoUpdatedAt',
        'socialLandscapeVideoRenderVersion',
        'socialLandscapeVideoDurationSeconds',
        'socialVideoClosingHeadline',
        'socialVideoClosingMessage',
        'socialVideoClosingShowQrCode',
        'socialVideoClosingImage',
        'socialVideoClosingCustomImageUrl',
        'socialVideoClosingDurationSeconds',
        'trailerVideoUrl',
        'trailerVideoMimeType',
        'trailerVideoUpdatedAt',
        'trailerVideoRenderVersion',
        'trailerVideoRatio',
        'trailerVideoAudioTrackId',
        'trailerVideoAudioVolume',
        'trailerVideoNarrationEnabled',
        'trailerVideoScript',
        'trailerVideoSourceFingerprint',
        'trailerVideoCardIds',
        'trailerVideoDurationSeconds',
        'trailerLandscapeVideoUrl',
        'trailerLandscapeVideoMimeType',
        'trailerLandscapeVideoUpdatedAt',
        'trailerLandscapeVideoRenderVersion',
        'trailerLandscapeVideoDurationSeconds',
        'narrationStyle',
        'narrationSecondsPerCard',
        'stackNarratorVoiceId',
        'stickers',
        'tourMeta',
        'nearbyGems',
        'learningQuiz',
        'parentBoardId',
        'parentCardId',
        'parentBoardTitle',
        'parentCardTitle',
        'insideCardsDisplay',
        'showCardNumbers',
        'like_count',
        'atlas_id',
        'generated_for_atlas_id',
        'cards',
        'created_at_iso',
        'updated_at_iso',
        'server_updated_at'
      ];
    }

    function isPhotoStudioDraft(data) {
      return data.keys().hasAll(['photoStoryBoard', 'photoStudioDraft'])
        && data.photoStoryBoard == true
        && data.photoStudioDraft == true
        && data.visibility == 'private'
        && data.kind == 'standard';
    }

    function isValidNearbyGemsMetadata(data) {
      return data.kind == 'nearby-gems'
        && data.keys().hasAny(['nearbyGems'])
        && data.nearbyGems is map
        && data.nearbyGems.keys().hasOnly([
          'locationLabel',
          'range',
          'travelMode',
          'defaultSort',
          'generatedAt',
          'originStored',
          'generationGrantId'
        ])
        && data.nearbyGems.keys().hasAll([
          'locationLabel',
          'range',
          'travelMode',
          'defaultSort',
          'generatedAt',
          'originStored',
          'generationGrantId'
        ])
        && data.nearbyGems.locationLabel is string
        && data.nearbyGems.locationLabel.size() >= 1
        && data.nearbyGems.locationLabel.size() <= 120
        && data.nearbyGems.range in ['walk', 'quick-drive', 'adventure']
        && data.nearbyGems.travelMode in ['walking', 'driving']
        && data.nearbyGems.defaultSort in ['travel-time', 'distance']
        && data.nearbyGems.generatedAt is string
        && data.nearbyGems.generatedAt.size() <= 80
        && data.nearbyGems.originStored == false
        && data.nearbyGems.generationGrantId is string
        && data.nearbyGems.generationGrantId.size() >= 20
        && data.nearbyGems.generationGrantId.size() <= 180;
    }

    function hasNearbyGemsGenerationGrant(data, boardId, requireFresh) {
      let grant = get(/databases/$(database)/documents/nearby_gem_generation_grants/$(data.nearbyGems.generationGrantId));
      return isValidNearbyGemsMetadata(data)
        && grant.data.owner_user_id == request.auth.uid
        && grant.data.board_id == boardId
        && (!requireFresh || grant.data.expires_at > request.time);
    }

    function boardCollectionKeys() {
      return [
        'id',
        'slug',
        'custom_slug',
        'owner_user_id',
        'owner_public_slug',
        'owner_display_name',
        'owner_photo_url',
        'owner_profile_icon',
        'owner_profile_picture_type',
        'visibility',
        'title',
        'description',
        'board_ids',
        'created_at_iso',
        'updated_at_iso',
        'server_updated_at'
      ];
    }

    function isValidBoardCollection(data, collectionId) {
      return data.keys().hasOnly(boardCollectionKeys())
        && data.keys().hasAll([
          'id',
          'slug',
          'owner_user_id',
          'owner_public_slug',
          'owner_display_name',
          'owner_photo_url',
          'owner_profile_icon',
          'owner_profile_picture_type',
          'visibility',
          'title',
          'description',
          'board_ids',
          'created_at_iso',
          'updated_at_iso',
          'server_updated_at'
        ])
        && data.id == collectionId
        && data.owner_user_id is string
        && data.owner_user_id == request.auth.uid
        && data.owner_public_slug is string
        && data.owner_public_slug.size() >= 1
        && data.owner_public_slug.size() <= 80
        && data.owner_public_slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && data.slug is string
        && data.slug.size() >= 1
        && data.slug.size() <= 80
        && data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && (
          !data.keys().hasAny(['custom_slug'])
          || (
            data.custom_slug is string
            && data.custom_slug.size() >= 3
            && data.custom_slug.size() <= 60
            && data.custom_slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          )
        )
        && (
          request.method == 'create'
            ? !data.keys().hasAny(['custom_slug'])
            : (
              resource.data.keys().hasAny(['custom_slug'])
                ? data.keys().hasAny(['custom_slug']) && data.custom_slug == resource.data.custom_slug
                : !data.keys().hasAny(['custom_slug'])
            )
        )
        && data.owner_display_name is string
        && data.owner_display_name.size() <= 120
        && data.owner_photo_url is string
        && data.owner_photo_url.size() <= 2000
        && data.owner_profile_icon is string
        && data.owner_profile_icon.size() <= 64
        && (data.owner_profile_picture_type == null || data.owner_profile_picture_type in ['icon', 'image'])
        && data.visibility == 'public'
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 280
        && data.board_ids is list
        && data.board_ids.size() >= 1
        && data.board_ids.size() <= 50
        && data.created_at_iso is string
        && data.updated_at_iso is string
        && data.server_updated_at == request.time;
    }

    function hasNoCityPublishingMetadata(data) {
      return (
        !data.keys().hasAny(['atlas_id'])
        || data.atlas_id == null
      )
      && (
        !data.keys().hasAny(['generated_for_atlas_id'])
        || data.generated_for_atlas_id == null
      )
      && !data.keys().hasAny([
        'origin', 'publisher_type',
        'generation_job_id', 'generation_item_id', 'generation_key',
        'generator_version', 'template_id', 'template_version', 'rubric_version',
        'editorial_status', 'city_listing_status', 'city_feature_order', 'source_status',
        'quality_status', 'quality_warnings', 'validation_summary', 'created_by_user_id',
        'approved_by_user_id', 'approved_at', 'deleted_at', 'deleted_by_user_id',
        'deletion_reason', 'deletion_snapshot'
      ]);
    }

    function userEditableProfileKeys() {
      return [
        'id',
        'authUid',
        'email',
        'emailVerified',
        'displayName',
        'photoURL',
        'profileIcon',
        'profilePictureType',
        'preferredCitySlug',
        'preferredUniversitySlug',
        'providers',
        'creationTime',
        'lastSignInTime',
        'updatedAt'
      ];
    }

    function isAtlasAdmin(data) {
      return isSignedIn()
        && data.admin_user_ids is list
        && request.auth.uid in data.admin_user_ids;
    }

    function canAdminAtlasById(atlasId) {
      return isSignedIn()
        && atlasId is string
        && atlasId.size() > 0
        && (
          get(/databases/$(database)/documents/atlases/$(atlasId)).data.user_id == request.auth.uid
          || (
            get(/databases/$(database)/documents/atlases/$(atlasId)).data.admin_user_ids is list
            && request.auth.uid in get(/databases/$(database)/documents/atlases/$(atlasId)).data.admin_user_ids
          )
        );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(userEditableProfileKeys());
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(userEditableProfileKeys());
      allow delete: if false;
    }

    match /users/{userId}/board_wizard_drafts/{draftId} {
      allow read, delete: if isOwner(userId);
      // Keep optional wizard preferences inside result.wizard_preferences.
      // Adding new top-level keys creates a client/rules deployment-order trap.
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'owner_user_id',
          'mode',
          'target_board_id',
          'locked_target_board_id',
          'contribution_board_id',
          'default_type',
          'count',
          'vibe',
          'media_mode',
          'narration_style',
          'prompt',
          'pasted_list',
          'source_url',
          'off_grid_name',
          'off_grid_address',
          'off_grid_tip',
          'stack_cta_label',
          'stack_cta_url',
          'tour_voice_style',
          'tour_pace_or_style',
          'tour_extras',
          'result',
          'selected_card_ids',
          'created_at_iso',
          'updated_at_iso',
          'server_updated_at'
        ])
        && request.resource.data.id == draftId
        && request.resource.data.owner_user_id == userId
        && (
          !request.resource.data.keys().hasAny(['narration_style'])
          || isValidBoardNarrationStyle(request.resource.data.narration_style)
        )
        && request.resource.data.mode in [
          'describe',
          'paste',
          'photos',
          'off-grid',
          'nearby-gems',
          'url',
          'walking-tour',
          'driving-tour'
        ]
        && request.resource.data.default_type in ['place', 'food', 'memory', 'idea', 'shop', 'note']
        && request.resource.data.vibe in ['playful', 'foodie', 'traveler', 'curator', 'memory']
        && (
          !request.resource.data.keys().hasAny(['media_mode'])
          || request.resource.data.media_mode in ['images', 'mixed', 'videos']
        )
        && request.resource.data.count is number
        && request.resource.data.count >= 1
        && request.resource.data.count <= 100
        && request.resource.data.result is map
        && request.resource.data.selected_card_ids is list
        && request.resource.data.tour_extras is list
        && request.resource.data.created_at_iso is string
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;
    }

    match /users/{userId}/videos/{videoId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'id',
          'owner_user_id',
          'source_type',
          'video_kind',
          'source_id',
          'source_title',
          'source_route',
          'source_updated_at_iso',
          'poster_url',
          'video_url',
          'storage_path',
          'public_storage_path',
          'public_share_url',
          'mime_type',
          'ratio',
          'duration_seconds',
          'render_version',
          'narration_enabled',
          'generated_at_iso',
          'landscape_video_url',
          'landscape_storage_path',
          'landscape_public_storage_path',
          'landscape_mime_type',
          'landscape_duration_seconds',
          'landscape_render_version',
          'landscape_generated_at_iso',
          'updated_at_iso',
          'server_updated_at'
        ])
        && request.resource.data.id == videoId
        && request.resource.data.owner_user_id == userId
        && request.resource.data.source_type == 'board'
        && request.resource.data.video_kind in ['full', 'trailer']
        && request.resource.data.source_id is string
        && request.resource.data.source_id.size() >= 1
        && request.resource.data.source_id.size() <= 128
        && request.resource.data.source_title is string
        && request.resource.data.source_title.size() >= 1
        && request.resource.data.source_title.size() <= 120
        && request.resource.data.source_route is string
        && request.resource.data.source_route.size() <= 240
        && request.resource.data.source_updated_at_iso is string
        && request.resource.data.source_updated_at_iso.size() <= 80
        && request.resource.data.poster_url is string
        && request.resource.data.poster_url.size() <= 2500
        && request.resource.data.video_url is string
        && request.resource.data.video_url.size() >= 1
        && request.resource.data.video_url.size() <= 2500
        && request.resource.data.storage_path is string
        && request.resource.data.storage_path.size() <= 500
        && request.resource.data.public_storage_path is string
        && request.resource.data.public_storage_path.size() <= 500
        && request.resource.data.public_share_url is string
        && request.resource.data.public_share_url.size() <= 2500
        && request.resource.data.mime_type is string
        && request.resource.data.mime_type.matches('video/.*')
        && request.resource.data.mime_type.size() <= 120
        && request.resource.data.ratio in ['vertical', 'square', 'landscape']
        && request.resource.data.duration_seconds is number
        && request.resource.data.duration_seconds >= 0
        && request.resource.data.render_version is string
        && request.resource.data.render_version.size() <= 64
        && request.resource.data.narration_enabled is bool
        && request.resource.data.generated_at_iso is string
        && request.resource.data.generated_at_iso.size() <= 80
        && hasValidLibraryLandscapeVariant(request.resource.data)
        && request.resource.data.updated_at_iso is string
        && request.resource.data.updated_at_iso.size() <= 80
        && request.resource.data.server_updated_at == request.time;
    }

    match /user_narrator_voices/{userId} {
      allow read, write: if false;

      match /voices/{voiceId} {
        allow read, write: if false;
      }
    }

    match /atlases/{atlasId} {
      allow read: if resource.data.is_public == true
        || (isSignedIn() && resource.data.user_id == request.auth.uid)
        || isAtlasAdmin(resource.data);
      allow list: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.user_id == request.auth.uid
        && canCreateWiki();
      allow update: if (isSignedIn() && resource.data.user_id == request.auth.uid)
        || (
          isAtlasAdmin(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name',
            'slug',
            'description',
            'landing_summary',
            'is_public',
            'logo_url',
            'hero_url',
            'video_url',
            'cover_color',
            'wiki_type',
            'city_config',
            'university_config',
            'chat_guide',
            'persona_prompt',
            'default_answer_mode',
            'updated_at'
          ])
        );
      allow delete: if isSignedIn() && resource.data.user_id == request.auth.uid;
    }

    match /documents/{documentId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /raw_extracts/{extractId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /knowledge_entries/{entryId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_topics/{topicId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_articles/{articleId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /wiki_index/{indexId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /queries/{queryId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /chat_threads/{threadId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /chat_messages/{messageId} {
      allow read: if isSignedIn() && resource.data.user_id == request.auth.uid;
      allow write: if false;
    }

    match /public_chat_threads/{threadId} {
      allow read: if isSignedIn() && (
        resource.data.atlas_owner_user_id == request.auth.uid
        || resource.data.visitor_uid == request.auth.uid
      );
      allow write: if false;
    }

    match /public_chat_messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.atlas_owner_user_id == request.auth.uid
        || resource.data.visitor_uid == request.auth.uid
      );
      allow write: if false;
    }

    match /atlas_voice_tool_calls/{callId} {
      allow read: if isSignedIn() && resource.data.atlas_owner_user_id == request.auth.uid;
      allow write: if false;
    }

    match /business_claims/{claimId} {
      allow get, list: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          'claim_key',
          'owner_user_id',
          'atlas_id',
          'city_name',
          'city_slug',
          'business_name',
          'business_slug',
          'business_address',
          'category',
          'place_id',
          'preview_url',
          'business_plan',
          'business_paid',
          'payment_status',
          'status',
          'created_at'
        ])
        && request.resource.data.claim_key == claimId
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.claim_key is string
        && request.resource.data.claim_key.size() >= 4
        && request.resource.data.claim_key.size() <= 180
        && request.resource.data.city_name is string
        && request.resource.data.city_name.size() >= 2
        && request.resource.data.city_name.size() <= 90
        && request.resource.data.city_slug is string
        && request.resource.data.city_slug.size() >= 2
        && request.resource.data.city_slug.size() <= 90
        && request.resource.data.business_name is string
        && request.resource.data.business_name.size() >= 2
        && request.resource.data.business_name.size() <= 120
        && request.resource.data.business_slug is string
        && request.resource.data.business_slug.size() >= 2
        && request.resource.data.business_slug.size() <= 90
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.preview_url is string
        && request.resource.data.preview_url.matches('https://livingwiki\\.com/.*')
        && (
          !request.resource.data.keys().hasAny(['business_plan'])
          || request.resource.data.business_plan in ['free', 'local', 'favorite', 'sponsor']
        )
        && (
          !request.resource.data.keys().hasAny(['business_paid'])
          || request.resource.data.business_paid == true
        )
        && (
          !request.resource.data.keys().hasAny(['payment_status'])
          || request.resource.data.payment_status == 'paid'
        )
        && request.resource.data.status == 'pending'
        && request.resource.data.created_at == request.time
        && !exists(/databases/$(database)/documents/business_claims/$(claimId));
      allow update: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'business_address',
          'category',
          'updated_at'
        ])
        && request.resource.data.business_address is string
        && request.resource.data.business_address.size() <= 180
        && request.resource.data.category is string
        && request.resource.data.category.size() <= 80
        && request.resource.data.updated_at == request.time
      ) || (
        isPlatformAdmin()
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.claim_key == resource.data.claim_key
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updated_at'
        ])
        && request.resource.data.status in ['pending', 'verified', 'rejected']
        && request.resource.data.updated_at == request.time
      );
      allow delete: if (
        isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
      ) || isPlatformAdmin();
    }

    match /board_collections/{collectionId} {
      allow get, list: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.owner_user_id == request.auth.uid)
        || isPlatformAdmin();
      allow create: if isSignedIn()
        && isValidBoardCollection(request.resource.data, collectionId);
      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_at_iso == resource.data.created_at_iso
        && isValidBoardCollection(request.resource.data, collectionId);
      allow delete: if (isSignedIn() && resource.data.owner_user_id == request.auth.uid)
        || isPlatformAdmin();
    }

    match /public_board_routes/{slug} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /public_board_summaries/{boardId} {
      allow get, list: if resource.data.visibility == 'public';
      allow create, update, delete: if false;
    }

    match /nearby_gem_generation_grants/{grantId} {
      allow read, write: if false;
    }

    match /public_collection_routes/{slug} {
      allow get: if true;
      allow list, create, update, delete: if false;
    }

    match /boards/{boardId} {
      allow get: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.owner_user_id == request.auth.uid)
        || (resource.data.atlas_id is string && canAdminAtlasById(resource.data.atlas_id))
        || isPlatformAdmin();
      allow list: if resource.data.visibility == 'public'
        || (isSignedIn() && resource.data.owner_user_id == request.auth.uid)
        || isPlatformAdmin();

      // Voice and visibility are intentionally small updates. In particular,
      // changing privacy must not re-validate or rewrite every card on a
      // historical board.
      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'stackNarratorVoiceId',
          'visibility',
          'photoStudioDraft',
          'updated_at_iso',
          'server_updated_at'
        ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['photoStudioDraft'])
          || (request.resource.data.photoStudioDraft == false && request.resource.data.visibility == 'public')
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stackNarratorVoiceId'])
          || isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['visibility'])
          || (
            request.resource.data.visibility in ['public', 'private']
            && (
              request.resource.data.visibility == 'public'
              || resource.data.kind == 'nearby-gems'
              || isPlatformAdmin()
              || hasActivePersonalWikiPlan()
            )
          )
        )
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      // Personal board saves use a compact validator so they remain below
      // Firestore's 1,000-expression evaluation limit. City publishing fields
      // are never accepted through this owner-controlled path.
      allow create: if isSignedIn()
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.id == boardId
        && request.resource.data.visibility == 'private'
        && hasNearbyGemsGenerationGrant(request.resource.data, boardId, true)
        && request.resource.data.keys().hasOnly(personalBoardKeys())
        && hasNoCityPublishingMetadata(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 200
        && (
          !request.resource.data.keys().hasAny(['stackNarratorVoiceId'])
          || isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        )
        && request.resource.data.server_updated_at == request.time;

      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.id == boardId
        && resource.data.kind == 'nearby-gems'
        && request.resource.data.kind == 'nearby-gems'
        && request.resource.data.visibility in ['public', 'private']
        && hasNearbyGemsGenerationGrant(request.resource.data, boardId, false)
        && request.resource.data.keys().hasOnly(personalBoardKeys())
        && hasNoCityPublishingMetadata(request.resource.data)
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 200
        && (
          !request.resource.data.keys().hasAny(['stackNarratorVoiceId'])
          || isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        )
        && request.resource.data.server_updated_at == request.time;

      allow create, update: if isSignedIn()
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.id == boardId
        && (request.method == 'create' || resource.data.owner_user_id == request.auth.uid)
        && request.resource.data.visibility in ['public', 'private']
        && (
          request.resource.data.visibility == 'public'
          || isPhotoStudioDraft(request.resource.data)
          || isPlatformAdmin()
          || hasActivePersonalWikiPlan()
        )
        && request.resource.data.keys().hasOnly(personalBoardKeys())
        && hasNoCityPublishingMetadata(request.resource.data)
        && request.resource.data.keys().hasAll([
          'id',
          'owner_user_id',
          'owner_public_slug',
          'owner_display_name',
          'owner_photo_url',
          'owner_profile_icon',
          'owner_profile_picture_type',
          'visibility',
          'title',
          'description',
          'backNote',
          'icon',
          'tone',
          'imageUrl',
          'logoUrl',
          'logoLinkUrl',
          'stackCtaLabel',
          'stackCtaUrl',
          'socialVideoUrl',
          'socialVideoMimeType',
          'socialVideoUpdatedAt',
          'socialVideoRatio',
          'stickers',
          'cards',
          'created_at_iso',
          'updated_at_iso',
          'server_updated_at'
        ])
        && request.resource.data.owner_public_slug is string
        && request.resource.data.owner_public_slug.size() >= 2
        && request.resource.data.owner_public_slug.size() <= 80
        && request.resource.data.owner_public_slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && (
          !request.resource.data.keys().hasAny(['custom_slug'])
          || (
            request.resource.data.custom_slug is string
            && request.resource.data.custom_slug.size() >= 3
            && request.resource.data.custom_slug.size() <= 60
            && request.resource.data.custom_slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
          )
        )
        && (
          request.method == 'create'
            ? !request.resource.data.keys().hasAny(['custom_slug'])
            : (
              resource.data.keys().hasAny(['custom_slug'])
                ? request.resource.data.keys().hasAny(['custom_slug'])
                  && request.resource.data.custom_slug == resource.data.custom_slug
                : !request.resource.data.keys().hasAny(['custom_slug'])
            )
        )
        && request.resource.data.owner_display_name is string
        && request.resource.data.owner_display_name.size() <= 120
        && request.resource.data.owner_photo_url is string
        && request.resource.data.owner_photo_url.size() <= 2000
        && request.resource.data.owner_profile_icon is string
        && request.resource.data.owner_profile_icon.size() <= 64
        && (
          request.resource.data.owner_profile_picture_type == null
          || request.resource.data.owner_profile_picture_type in ['icon', 'image']
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.backNote is string
        && request.resource.data.backNote.size() <= 300
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 64
        && request.resource.data.tone in ['teal', 'coral', 'yellow', 'green', 'blue', 'sky', 'purple']
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.logoUrl is string
        && request.resource.data.logoUrl.size() <= 2000
        && request.resource.data.logoLinkUrl is string
        && request.resource.data.logoLinkUrl.size() <= 240
        && request.resource.data.stackCtaLabel is string
        && request.resource.data.stackCtaLabel.size() <= 48
        && request.resource.data.stackCtaUrl is string
        && request.resource.data.stackCtaUrl.size() <= 240
        && request.resource.data.socialVideoUrl is string
        && request.resource.data.socialVideoUrl.size() <= 2000
        && request.resource.data.socialVideoMimeType is string
        && request.resource.data.socialVideoMimeType.size() <= 120
        && request.resource.data.socialVideoUpdatedAt is string
        && request.resource.data.socialVideoUpdatedAt.size() <= 80
        && request.resource.data.socialVideoRatio in ['vertical', 'square', 'landscape']
        && hasValidSocialVideoClosingScreen(request.resource.data)
        && hasValidBoardNarrationLength(request.resource.data)
        && (
          !request.resource.data.keys().hasAny(['stackNarratorVoiceId'])
          || isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        )
        && request.resource.data.stickers is list
        && request.resource.data.stickers.size() <= 48
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 200
        && request.resource.data.created_at_iso is string
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      // A personal copy is created from a public source board with fresh card
      // IDs and no generated media. Keep this path intentionally narrow and
      // inexpensive to evaluate: the full legacy-board validator can exceed
      // Firestore's expression limit on larger otherwise-valid boards.
      allow create: if isSignedIn()
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.id == boardId
        && request.resource.data.visibility == 'public'
        && request.resource.data.keys().hasOnly([
          'id',
          'owner_user_id',
          'owner_public_slug',
          'owner_display_name',
          'owner_photo_url',
          'owner_profile_icon',
          'owner_profile_picture_type',
          'forkedFromBoardId',
          'forkedFromTitle',
          'forkedFromOwnerUserId',
          'forkedFromOwnerName',
          'visibility',
          'kind',
          'sortOrder',
          'title',
          'description',
          'backNote',
          'icon',
          'tone',
          'imageUrl',
          'logoUrl',
          'logoLinkUrl',
          'stackCtaLabel',
          'stackCtaUrl',
          'socialVideoUrl',
          'socialVideoMimeType',
          'socialVideoUpdatedAt',
          'socialVideoRenderVersion',
          'socialVideoRatio',
          'socialVideoAudioTrackId',
          'socialVideoAudioVolume',
          'socialVideoNarrationEnabled',
          'socialLandscapeVideoUrl',
          'socialLandscapeVideoMimeType',
          'socialLandscapeVideoUpdatedAt',
          'socialLandscapeVideoRenderVersion',
          'socialLandscapeVideoDurationSeconds',
          'socialVideoClosingHeadline',
          'socialVideoClosingMessage',
          'socialVideoClosingShowQrCode',
          'socialVideoClosingImage',
          'socialVideoClosingCustomImageUrl',
          'socialVideoClosingDurationSeconds',
          'trailerVideoUrl',
          'trailerVideoMimeType',
          'trailerVideoUpdatedAt',
          'trailerVideoRenderVersion',
          'trailerVideoRatio',
          'trailerVideoAudioTrackId',
          'trailerVideoAudioVolume',
          'trailerVideoNarrationEnabled',
          'trailerVideoScript',
          'trailerVideoSourceFingerprint',
          'trailerVideoCardIds',
          'trailerVideoDurationSeconds',
          'trailerLandscapeVideoUrl',
          'trailerLandscapeVideoMimeType',
          'trailerLandscapeVideoUpdatedAt',
          'trailerLandscapeVideoRenderVersion',
          'trailerLandscapeVideoDurationSeconds',
          'narrationStyle',
          'narrationSecondsPerCard',
          'stackNarratorVoiceId',
          'stickers',
          'tourMeta',
          'learningQuiz',
          'parentBoardId',
          'parentCardId',
          'parentBoardTitle',
          'parentCardTitle',
          'insideCardsDisplay',
          'showCardNumbers',
          'like_count',
          'cards',
          'created_at_iso',
          'updated_at_iso',
          'server_updated_at'
        ])
        && request.resource.data.forkedFromBoardId is string
        && request.resource.data.forkedFromBoardId.size() >= 1
        && request.resource.data.forkedFromBoardId.size() <= 128
        && exists(/databases/$(database)/documents/boards/$(request.resource.data.forkedFromBoardId))
        && get(/databases/$(database)/documents/boards/$(request.resource.data.forkedFromBoardId)).data.visibility == 'public'
        && request.resource.data.forkedFromOwnerUserId
          == get(/databases/$(database)/documents/boards/$(request.resource.data.forkedFromBoardId)).data.owner_user_id
        && request.resource.data.forkedFromTitle
          == get(/databases/$(database)/documents/boards/$(request.resource.data.forkedFromBoardId)).data.title
        && request.resource.data.owner_public_slug is string
        && request.resource.data.owner_public_slug.size() >= 2
        && request.resource.data.owner_public_slug.size() <= 80
        && request.resource.data.owner_public_slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$')
        && request.resource.data.owner_display_name is string
        && request.resource.data.owner_display_name.size() <= 120
        && request.resource.data.owner_photo_url is string
        && request.resource.data.owner_photo_url.size() <= 2000
        && request.resource.data.owner_profile_icon is string
        && request.resource.data.owner_profile_icon.size() <= 64
        && (
          request.resource.data.owner_profile_picture_type == null
          || request.resource.data.owner_profile_picture_type in ['icon', 'image']
        )
        && request.resource.data.kind in ['standard', 'off-grid', 'walking-tour', 'driving-tour']
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 90
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 240
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 64
        && request.resource.data.tone in ['teal', 'coral', 'yellow', 'green', 'blue', 'sky', 'purple']
        && request.resource.data.socialVideoUrl == ''
        && request.resource.data.socialVideoMimeType == ''
        && request.resource.data.socialVideoUpdatedAt == ''
        && hasValidSocialVideoClosingScreen(request.resource.data)
        && request.resource.data.trailerVideoUrl == ''
        && request.resource.data.trailerVideoMimeType == ''
        && request.resource.data.trailerVideoUpdatedAt == ''
        && request.resource.data.trailerVideoScript == ''
        && request.resource.data.trailerVideoSourceFingerprint == ''
        && request.resource.data.trailerVideoCardIds is list
        && request.resource.data.trailerVideoCardIds.size() == 0
        && request.resource.data.trailerVideoDurationSeconds == 0
        && hasValidBoardNarrationLength(request.resource.data)
        && isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        && request.resource.data.parentBoardId == ''
        && request.resource.data.parentCardId == ''
        && request.resource.data.parentBoardTitle == ''
        && request.resource.data.parentCardTitle == ''
        && request.resource.data.learningQuiz == null
        && request.resource.data.stickers is list
        && request.resource.data.stickers.size() <= 48
        && request.resource.data.cards is list
        && request.resource.data.cards.size() <= 200
        && request.resource.data.created_at_iso is string
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      // Trailer publishing is a narrow owner-only update. Keep it independent
      // from the full-board validator so an older, otherwise valid board cannot
      // block a newly rendered trailer because of an unrelated legacy field.
      // Use updateDoc so callable-written script metadata and cards are preserved.
      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'trailerVideoUrl',
          'trailerVideoMimeType',
          'trailerVideoUpdatedAt',
          'trailerVideoRenderVersion',
          'trailerVideoRatio',
          'trailerVideoAudioTrackId',
          'trailerVideoAudioVolume',
          'trailerVideoNarrationEnabled',
          'trailerVideoScript',
          'trailerVideoSourceFingerprint',
          'trailerVideoCardIds',
          'trailerVideoDurationSeconds',
          'trailerLandscapeVideoUrl',
          'trailerLandscapeVideoMimeType',
          'trailerLandscapeVideoUpdatedAt',
          'trailerLandscapeVideoRenderVersion',
          'trailerLandscapeVideoDurationSeconds',
          'trailerVideoScriptUpdatedAt',
          'stackNarratorVoiceId',
          'updated_at_iso',
          'server_updated_at'
        ])
        && request.resource.data.trailerVideoUrl is string
        && request.resource.data.trailerVideoUrl.size() >= 1
        && request.resource.data.trailerVideoUrl.size() <= 2500
        && request.resource.data.trailerVideoMimeType is string
        && request.resource.data.trailerVideoMimeType.matches('video/.*')
        && request.resource.data.trailerVideoMimeType.size() <= 120
        && request.resource.data.trailerVideoUpdatedAt is string
        && request.resource.data.trailerVideoUpdatedAt.size() <= 80
        && request.resource.data.trailerVideoRenderVersion is string
        && request.resource.data.trailerVideoRenderVersion.size() <= 64
        && request.resource.data.trailerVideoRatio in ['vertical', 'square', 'landscape']
        && request.resource.data.trailerVideoAudioTrackId is string
        && request.resource.data.trailerVideoAudioTrackId.size() <= 80
        && request.resource.data.trailerVideoAudioVolume is number
        && request.resource.data.trailerVideoAudioVolume >= 0
        && request.resource.data.trailerVideoAudioVolume <= 0.5
        && request.resource.data.trailerVideoNarrationEnabled is bool
        && request.resource.data.trailerVideoScript is string
        && request.resource.data.trailerVideoScript.size() <= 620
        && request.resource.data.trailerVideoSourceFingerprint is string
        && request.resource.data.trailerVideoSourceFingerprint.size() <= 128
        && request.resource.data.trailerVideoCardIds is list
        && request.resource.data.trailerVideoCardIds.size() <= 30
        && request.resource.data.trailerVideoDurationSeconds is number
        && request.resource.data.trailerVideoDurationSeconds >= 0
        && request.resource.data.trailerVideoDurationSeconds <= 30
        && hasValidLandscapeVideoFields(request.resource.data)
        && isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      // Completed videos only change video metadata, even on legacy/private boards.
      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'socialVideoUrl', 'socialVideoMimeType', 'socialVideoUpdatedAt', 'socialVideoRenderVersion',
          'socialVideoRatio', 'socialVideoAudioTrackId', 'socialVideoAudioVolume', 'socialVideoNarrationEnabled',
          'socialLandscapeVideoUrl', 'socialLandscapeVideoMimeType', 'socialLandscapeVideoUpdatedAt',
          'socialLandscapeVideoRenderVersion', 'socialLandscapeVideoDurationSeconds',
          'stackNarratorVoiceId', 'updated_at_iso', 'server_updated_at'
        ])
        && request.resource.data.socialVideoUrl is string
        && request.resource.data.socialVideoUrl.size() >= 1
        && request.resource.data.socialVideoUrl.size() <= 2500
        && request.resource.data.socialVideoMimeType is string
        && request.resource.data.socialVideoMimeType.matches('video/.*')
        && request.resource.data.socialVideoMimeType.size() <= 120
        && request.resource.data.socialVideoUpdatedAt is string
        && request.resource.data.socialVideoUpdatedAt.size() <= 80
        && request.resource.data.socialVideoRenderVersion is string
        && request.resource.data.socialVideoRenderVersion.size() <= 64
        && request.resource.data.socialVideoRatio in ['vertical', 'square', 'landscape']
        && request.resource.data.socialVideoAudioTrackId is string
        && request.resource.data.socialVideoAudioTrackId.size() <= 80
        && request.resource.data.socialVideoAudioVolume is number
        && request.resource.data.socialVideoAudioVolume >= 0
        && request.resource.data.socialVideoAudioVolume <= 0.5
        && request.resource.data.socialVideoNarrationEnabled is bool
        && hasValidLandscapeVideoFields(request.resource.data)
        && isValidStackNarratorVoiceId(request.resource.data.stackNarratorVoiceId)
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      // My Videos also clears references without rewriting the source board.
      function clearsBoardVideo(prefix) {
        return request.resource.data.get(prefix + 'VideoUrl', null) == ''
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            prefix + 'VideoUrl', prefix + 'VideoMimeType', prefix + 'VideoUpdatedAt', prefix + 'VideoRenderVersion',
            prefix + 'LandscapeVideoUrl', prefix + 'LandscapeVideoMimeType', prefix + 'LandscapeVideoUpdatedAt',
            prefix + 'LandscapeVideoRenderVersion', prefix + 'LandscapeVideoDurationSeconds',
            'updated_at_iso', 'server_updated_at'
          ])
          && request.resource.data[prefix + 'VideoUrl'] == ''
          && request.resource.data[prefix + 'VideoMimeType'] == ''
          && request.resource.data[prefix + 'VideoUpdatedAt'] == ''
          && request.resource.data[prefix + 'VideoRenderVersion'] == ''
          && request.resource.data[prefix + 'LandscapeVideoUrl'] == ''
          && request.resource.data[prefix + 'LandscapeVideoMimeType'] == ''
          && request.resource.data[prefix + 'LandscapeVideoUpdatedAt'] == ''
          && request.resource.data[prefix + 'LandscapeVideoRenderVersion'] == ''
          && request.resource.data[prefix + 'LandscapeVideoDurationSeconds'] == 0;
      }

      allow update: if isSignedIn()
        && resource.data.owner_user_id == request.auth.uid
        && (clearsBoardVideo('social') || clearsBoardVideo('trailer'))
        && request.resource.data.updated_at_iso is string
        && request.resource.data.server_updated_at == request.time;

      allow create, update: if isSignedIn()
        && (
          (
            request.method == 'create'
            && request.resource.data.owner_user_id == request.auth.uid
          )
          || (
            request.method == 'update'
            && (resource.data.owner_user_id == request.auth.uid || isPlatformAdmin())
            && request.resource.data.owner_user_id == resource.data.owner_user_id
          )
        )
        && request.resource.data.visibility in ['public', 'private']
        && (
          request.resource.data.visibility == 'public'
          || isPlatformAdmin()
          || hasActivePersonalWikiPlan()
        )
        && request.resource.data.keys().hasOnly([
          'id',
          'owner_user_id',
          'owner_public_slug',
          'owner_display_name',
          'owner_photo_url',
          'owner_profile_icon',
          'owner_profile_picture_type',
          'forkedFromBoardId',
          'forkedFromTitle',
          'forkedFromOwnerUserId',
          'forkedFromOwnerName',
          'visibility',
          'kind',
          'sortOrder',
          'title',
          'description',
          'backNote',
          'icon',
          'tone',
          'imageUrl',
          'logoUrl',
          'logoLinkUrl',
          'stackCtaLabel',
          'stackCtaUrl',
          'socialVideoUrl',
          'socialVideoMimeType',
          'socialVideoUpdatedAt',
          'socialVideoRenderVersion',
          'socialVideoRatio',
          'socialVideoAudioTrackId',
          'socialVideoAudioVolume',
          'socialVideoNarrationEnabled',
